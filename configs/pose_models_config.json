{
  "_description": "Unified Configuration for Human Pose Estimation Benchmark, Inference & Training",
  "global_settings": {
    "weights_dir": "weights",
    "camera": {
      "camera_index": 1,
      "fallback_indices": [
        0,
        1,
        2,
        3,
        4,
        5
      ],
      "width": 1280,
      "height": 720,
      "fps": 30
    },
    "benchmark": {
      "num_frames": 300,
      "warmup_frames": 20,
      "use_webcam": true,
      "camera_index": 1,
      "frame_width": 640,
      "frame_height": 480,
      "save_synthetic_samples": true,
      "synthetic_samples_count": 10,
      "synthetic_samples_dir": "benchmark_results/synthetic_samples",
      "results_dir": "benchmark_results",
      "results_json": "benchmark_results/results.json",
      "results_report": "benchmark_results/report.md"
    },
    "visualization": {
      "show_hud": true,
      "hud_bg_color": [
        20,
        20,
        20
      ],
      "hud_opacity": 0.6,
      "depth_visual_mode": "depth_radius_and_intensity",
      "point_radius_min": 3,
      "point_radius_max": 20
    }
  },
  "models": {
    "mediapipe_pose_lite": {
      "enabled": true,
      "model_type": "mediapipe",
      "model_name": "MediaPipe Pose LITE (complexity=0)",
      "task_file": "pose_landmarker_lite.task",
      "num_poses": 1,
      "min_pose_detection_confidence": 0.5,
      "min_pose_presence_confidence": 0.5,
      "min_tracking_confidence": 0.5,
      "visibility_draw_threshold": 0.2,
      "has_3d_depth": true,
      "point_radius_min": 3,
      "point_radius_max": 10,
      "params_m": 3.3,
      "keypoints": 33,
      "multi_person": true,
      "notes": "BlazePose Lite (complexity 0), float16, ~5.8 MB, 33 3D landmarks"
    },
    "mediapipe_pose_full": {
      "enabled": true,
      "model_type": "mediapipe",
      "model_name": "MediaPipe Pose FULL (complexity=1)",
      "task_file": "pose_landmarker_full.task",
      "num_poses": 1,
      "min_pose_detection_confidence": 0.5,
      "min_pose_presence_confidence": 0.5,
      "min_tracking_confidence": 0.5,
      "visibility_draw_threshold": 0.2,
      "has_3d_depth": true,
      "point_radius_min": 3,
      "point_radius_max": 10,
      "params_m": 8.4,
      "keypoints": 33,
      "multi_person": true,
      "notes": "BlazePose Full (complexity 1), float16, ~9.4 MB, 33 3D landmarks"
    },
    "movenet_lightning": {
      "enabled": true,
      "model_type": "movenet",
      "model_name": "MoveNet Lightning",
      "model_file": "movenet_lightning.tflite",
      "input_size": 192,
      "score_threshold": 0.3,
      "has_3d_depth": false,
      "point_radius_min": 3,
      "point_radius_max": 8,
      "params_m": 3.6,
      "keypoints": 17,
      "multi_person": false,
      "notes": "MoveNet Lightning, uint8 quantized, ~4.8 MB, 17 COCO keypoints (single person)"
    },
    "movenet_thunder": {
      "enabled": true,
      "model_type": "movenet",
      "model_name": "MoveNet Thunder",
      "model_file": "movenet_thunder.tflite",
      "input_size": 256,
      "score_threshold": 0.3,
      "has_3d_depth": false,
      "point_radius_min": 3,
      "point_radius_max": 8,
      "params_m": 25.9,
      "keypoints": 17,
      "multi_person": false,
      "notes": "MoveNet Thunder, uint8 quantized, ~12.6 MB, 17 COCO keypoints (single person, higher accuracy)"
    },
    "yolo11n": {
      "enabled": true,
      "model_type": "yolo_detection",
      "model_name": "YOLO11n (Nano Object Detector)",
      "weights_file": "yolo11n.pt",
      "input_size": 640,
      "conf_threshold": 0.35,
      "iou_threshold": 0.45,
      "device": "cpu",
      "half_precision": false,
      "params_m": 2.6,
      "notes": "YOLO11 Nano object detection model (~5.6 MB), real-time edge detection and RAM profiling"
    },
    "yolo26n_pose": {
      "enabled": true,
      "model_type": "yolo",
      "model_name": "YOLO26n-pose (Nano)",
      "weights_file": "yolo26n-pose.pt",
      "input_size": 640,
      "conf_threshold": 0.5,
      "iou_threshold": 0.45,
      "device": "cpu",
      "half_precision": false,
      "has_3d_depth": false,
      "point_radius_min": 3,
      "point_radius_max": 8,
      "params_m": 2.9,
      "keypoints": 17,
      "multi_person": true,
      "notes": "YOLO-Pose Nano architecture, ultra-fast multi-person pose estimation",
      "train_config": {
        "dataset_yaml": "coco8-pose.yaml",
        "epochs": 50,
        "batch_size": 16,
        "imgsz": 640,
        "lr0": 0.01,
        "optimizer": "AdamW",
        "save_dir": "runs/pose/yolo26n_pose"
      }
    },
    "yolo26m_pose": {
      "enabled": true,
      "model_type": "yolo",
      "model_name": "YOLO26m-pose (Medium)",
      "weights_file": "yolo26m-pose.pt",
      "input_size": 640,
      "conf_threshold": 0.5,
      "iou_threshold": 0.45,
      "device": "cpu",
      "half_precision": false,
      "has_3d_depth": false,
      "point_radius_min": 3,
      "point_radius_max": 8,
      "params_m": 20.3,
      "keypoints": 17,
      "multi_person": true,
      "notes": "YOLO-Pose Medium architecture, balanced speed and accuracy for multi-person pose",
      "train_config": {
        "dataset_yaml": "coco8-pose.yaml",
        "epochs": 50,
        "batch_size": 8,
        "imgsz": 640,
        "lr0": 0.01,
        "optimizer": "AdamW",
        "save_dir": "runs/pose/yolo26m_pose"
      }
    },
    "yolo26x_pose": {
      "enabled": true,
      "model_type": "yolo",
      "model_name": "YOLO26x-pose (XLarge)",
      "weights_file": "yolo26x-pose.pt",
      "input_size": 640,
      "conf_threshold": 0.5,
      "iou_threshold": 0.45,
      "device": "cpu",
      "half_precision": false,
      "has_3d_depth": false,
      "point_radius_min": 3,
      "point_radius_max": 8,
      "params_m": 56.9,
      "keypoints": 17,
      "multi_person": true,
      "notes": "YOLO-Pose Extra-Large architecture, maximum accuracy for complex multi-person scenes",
      "train_config": {
        "dataset_yaml": "coco8-pose.yaml",
        "epochs": 50,
        "batch_size": 4,
        "imgsz": 640,
        "lr0": 0.005,
        "optimizer": "AdamW",
        "save_dir": "runs/pose/yolo26x_pose"
      }
    }
  }
}