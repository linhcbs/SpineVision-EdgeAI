{
  "_description": "Comprehensive Configuration for SpineVision EdgeAI Posture Analyzer",
  "camera": {
    "camera_index": 0,
    "fallback_indices": [
      1,
      2,
      3,
      4
    ],
    "width": 1280,
    "height": 720,
    "fps": 30
  },
  "smoothing": {
    "enabled": true,
    "filter_type": "one_euro",
    "one_euro": {
      "min_cutoff": 1.0,
      "beta": 0.005,
      "d_cutoff": 1.0
    },
    "ema": {
      "alpha": 0.3
    }
  },
  "keypoints": {
    "min_confidence": 0.2
  },
  "metrics": {
    "neck_cva": {
      "name": "Craniovertebral Angle",
      "abbreviation": "CVA",
      "unit": "deg",
      "normal_min": 80.0,
      "mild_min": 70.0,
      "severe_below": 70.0
    },
    "shoulder_tilt": {
      "name": "Shoulder Level Angle",
      "abbreviation": "Shoulder Level",
      "unit": "deg",
      "display_scale": "180_to_90",
      "normal_min": 175.0,
      "warning_min": 172.0,
      "severe_below": 172.0,
      "raw_tilt_thresholds": {
        "normal_max": 5.0,
        "warning_max": 8.0,
        "severe_above": 8.0
      }
    },
    "trunk_angle": {
      "name": "Trunk Slump Angle",
      "abbreviation": "Trunk Angle",
      "unit": "deg",
      "normal_max": 10.0,
      "warning_max": 18.0,
      "severe_above": 18.0
    },
    "eye_to_screen_distance": {
      "name": "Eye to Screen Distance",
      "abbreviation": "Eye - Screen",
      "unit": "cm",
      "safe_min": 35.0,
      "warning_min": 25.0,
      "danger_below": 25.0,
      "average_ipd_cm": 6.3,
      "default_focal_length_px": 650.0,
      "z_depth_dampening": 0.3
    },
    "eye_to_desk_distance": {
      "name": "Eye to Desk Distance",
      "abbreviation": "Eye - Desk",
      "unit": "cm",
      "safe_min": 35.0,
      "warning_min": 25.0,
      "danger_below": 25.0
    }
  },
  "view_modes": {
    "enabled": true,
    "hysteresis_deg": 5.0,
    "yaw_smoothing_alpha": 0.25,
    "frontal": {
      "max_yaw_deg": 25.0,
      "neck_cva": {
        "normal_min": 80.0,
        "mild_min": 70.0,
        "severe_below": 70.0
      },
      "shoulder_tilt": {
        "enabled": true,
        "normal_min": 175.0,
        "warning_min": 172.0,
        "severe_below": 172.0,
        "raw_tilt_thresholds": {
          "normal_max": 5.0,
          "warning_max": 8.0,
          "severe_above": 8.0
        }
      }
    },
    "oblique": {
      "max_yaw_deg": 65.0,
      "neck_cva": {
        "normal_min": 65.0,
        "mild_min": 55.0,
        "severe_below": 50.0
      },
      "shoulder_tilt": {
        "enabled": true,
        "normal_min": 175.0,
        "warning_min": 172.0,
        "severe_below": 172.0,
        "raw_tilt_thresholds": {
          "normal_max": 5.0,
          "warning_max": 8.0,
          "severe_above": 8.0
        }
      }
    },
    "profile": {
      "neck_cva": {
        "normal_min": 52.0,
        "mild_min": 45.0,
        "severe_below": 40.0
      },
      "shoulder_tilt": {
        "enabled": false,
        "normal_min": 175.0,
        "warning_min": 172.0,
        "severe_below": 172.0,
        "raw_tilt_thresholds": {
          "normal_max": 5.0,
          "warning_max": 8.0,
          "severe_above": 8.0
        }
      }
    }
  },
  "calibration": {
    "target_samples": 90,
    "calibration_distance_cm": 60.0,
    "relative_deviations": {
      "neck_cva_warn_deg": 8.0,
      "neck_cva_severe_deg": 15.0,
      "shoulder_tilt_warn_deg": 4.0,
      "shoulder_tilt_severe_deg": 8.0,
      "trunk_angle_warn_deg": 8.0,
      "trunk_angle_severe_deg": 15.0,
      "screen_distance_warn_cm": 15.0,
      "screen_distance_severe_cm": 25.0,
      "desk_distance_warn_cm": 10.0,
      "desk_distance_severe_cm": 18.0
    }
  },
  "classification": {
    "use_relative_when_calibrated": true,
    "default_sensitivity": 1.0,
    "mode": "hybrid",
    "enable_ml": true,
    "severity_levels": {
      "mild_threshold": 0.4,
      "critical_threshold": 0.8
    },
    "prolonged_risk": {
      "kyphosis_max_exposure_s": 45.0,
      "myopia_max_exposure_s": 45.0,
      "recovery_half_life_s": 10.0
    }
  },
  "workspace_detection": {
    "enabled": true,
    "desk_smoothing": 0.15,
    "min_confidence": 0.3,
    "desk_offset_ratio": 0.05,
    "screen_width_ratio": 0.65,
    "screen_aspect_ratio": 0.5625,
    "opacity": 0.3
  },
  "screen_detection": {
    "enabled": true,
    "model_path": "models/weights/yolo11n.pt",
    "max_devices": 2,
    "min_confidence": 0.10,
    "iou_threshold": 0.30,
    "draw_boxes": true,
    "box_opacity": 0.18
  },
  "visualization_hud": {
    "language": "en",
    "show_ram": true,
    "show_fps_latency": true,
    "panel_width": 330,
    "panel_opacity": 0.78,
    "status_labels": {
      "GOOD": "Upright / Straight",
      "FORWARD_HEAD": "Forward Head (Tech Neck)",
      "SLOUCHED": "Slouched (Kyphosis)",
      "SHOULDER_TILTED": "Shoulder Tilted",
      "LEANING_LEFT": "Leaning Left",
      "LEANING_RIGHT": "Leaning Right",
      "TOO_CLOSE": "Screen Too Close",
      "TOO_CLOSE_DESK": "Too Close to Desk",
      "COMBINED": "Combined Violations",
      "UNKNOWN": "Detecting..."
    }
  }
}